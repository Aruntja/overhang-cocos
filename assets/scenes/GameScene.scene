{
  "scene": "GameScene",
  "designResolution": {
    "width": 1080,
    "height": 1920,
    "policy": "FIXED_HEIGHT",
    "fitWidth": true,
    "fitHeight": true
  },
  "hierarchy": {
    "Canvas": {
      "size": [1080, 1920],
      "components": ["Canvas", "GameManager"],
      "inspector": {
        "script": "assets/scripts/core/GameManager.ts",
        "properties": {
          "blocksContainer": "Canvas/GameLayer/BlocksContainer",
          "swingContainer": "Canvas/GameLayer/SwingContainer",
          "debrisContainer": "Canvas/GameLayer/DebrisContainer",
          "particlesContainer": "Canvas/GameLayer/ParticlesContainer",
          "blockBasePrefab": "assets/prefabs/blocks/BlockBase.prefab",
          "blockFloorPrefab": "assets/prefabs/blocks/BlockFloor.prefab",
          "blockSwingPrefab": "assets/prefabs/blocks/BlockSwing.prefab",
          "debrisPrefab": "assets/prefabs/effects/Debris.prefab",
          "particlePrefab": "assets/prefabs/effects/Particle.prefab",
          "dustCloudPrefab": "assets/prefabs/effects/DustCloud.prefab",
          "cameraController": "Canvas/GameLayer",
          "uiManager": "Canvas/UILayer"
        }
      },
      "children": {
        "GameLayer": {
          "position": [0, 0, 0],
          "size": [1080, 1920],
          "components": ["CameraController"],
          "inspector": {
            "script": "assets/scripts/core/CameraController.ts",
            "properties": {
              "gameLayer": "Canvas/GameLayer"
            }
          },
          "children": {
            "BlocksContainer": {
              "children": {
                "BlockFloor": {
                  "prefab": "assets/prefabs/blocks/BlockFloor.prefab"
                }
              }
            },
            "SwingContainer": {
              "children": {
                "Swing": {
                  "prefab": "assets/prefabs/blocks/BlockSwing.prefab",
                  "children": {
                    "RopeNode": {}
                  }
                }
              }
            },
            "DebrisContainer": {
              "children": {
                "DebrisSample": {
                  "prefab": "assets/prefabs/effects/Debris.prefab"
                }
              }
            },
            "ParticlesContainer": {
              "children": {
                "ParticleSample": {
                  "prefab": "assets/prefabs/effects/Particle.prefab"
                }
              }
            }
          }
        },
        "UILayer": {
          "position": [0, 0, 0],
          "size": [1080, 1920],
          "components": ["UIManager"],
          "inspector": {
            "script": "assets/scripts/ui/UIManager.ts",
            "properties": {
              "hudController": "Canvas/UILayer/TopPanel",
              "controlBarController": "Canvas/UILayer/BottomPanel/ControlBar",
              "ladderController": "Canvas/UILayer/LeftPanel/LadderDisplay",
              "cashOutButton": "Canvas/UILayer/BottomPanel/CashOutButton",
              "resultBanner": "Canvas/UILayer/ResultBanner",
              "resultBannerLabel": "Canvas/UILayer/ResultBanner/Message"
            }
          },
          "children": {
            "TopPanel": {
              "prefab": "assets/prefabs/ui/HUDPanel.prefab",
              "components": ["HUDController"],
              "inspector": {
                "script": "assets/scripts/ui/HUDController.ts",
                "properties": {
                  "heightLabel": "Canvas/UILayer/TopPanel/HeightPill/Label",
                  "balanceLabel": "Canvas/UILayer/TopPanel/BalancePill/Label",
                  "multiplierLabel": "Canvas/UILayer/CenterDisplay/MultiplierText",
                  "payoutLabel": "Canvas/UILayer/CenterDisplay/PayoutText",
                  "toastNode": "Canvas/UILayer/CenterDisplay/ToastNotification",
                  "toastLabel": "Canvas/UILayer/CenterDisplay/ToastNotification/Label"
                }
              },
              "children": {
                "HeightPill": {
                  "children": {
                    "Label": {}
                  }
                },
                "BalancePill": {
                  "children": {
                    "Label": {}
                  }
                }
              }
            },
            "CenterDisplay": {
              "children": {
                "MultiplierText": { "position": [0, 820, 0] },
                "PayoutText": { "position": [0, 760, 0] },
                "ToastNotification": {
                  "position": [0, 250, 0],
                  "children": {
                    "Label": {}
                  }
                }
              }
            },
            "LeftPanel": {
              "children": {
                "LadderDisplay": {
                  "prefab": "assets/prefabs/ui/LadderDisplay.prefab",
                  "components": ["LadderController"]
                },
                "LadderControls": {}
              }
            },
            "BottomPanel": {
              "children": {
                "ControlBar": {
                  "prefab": "assets/prefabs/ui/ControlBar.prefab",
                  "components": ["ControlBarController"],
                  "children": {
                    "StatsRow": {},
                    "SteppersRow": {
                      "children": {
                        "BetStepper": {},
                        "DifficultyStepper": {}
                      }
                    },
                    "ActionButton": {}
                  }
                },
                "CashOutButton": {}
              }
            },
            "ResultBanner": {
              "prefab": "assets/prefabs/ui/ResultBanner.prefab",
              "active": false,
              "children": {
                "Message": {}
              }
            }
          }
        }
      }
    }
  }
}
